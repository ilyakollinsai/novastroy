# Реквизиты приложения Telegram — получить один раз на https://my.telegram.org (API development tools)
TG_API_ID=123456
TG_API_HASH=change_me
# Номер телефона аккаунта, который подписан на публичный канал НоваСтрой
TG_PHONE=+79990000000
# @username или t.me/ ссылка публичного канала (без @ и без https://t.me/)
TG_CHANNEL=novastroy_tenders

# Куда сохранять скачанные фото/документы из постов
MEDIA_DIR=media

# Периодичность опроса канала (в минутах)
POLL_INTERVAL_MINUTES=30

# MySQL — та же база, что и у backend
DB_HOST=localhost
DB_PORT=3306
DB_USER=novastroy_user
DB_PASSWORD=change_me
DB_NAME=novastroy
